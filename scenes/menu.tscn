theme_override_constants/outline_size = 10
theme_override_font_sizes/normal_font_size = 20
text = "The cube is a mythical, magical shield wielded by only the strongest warriors for generations. It was especially know for its great ranged defence and utter uselessness in meele defence. 

TIP: Holding the cube slows you down, but holding it while sliding retains your momentum."
fit_content = true

