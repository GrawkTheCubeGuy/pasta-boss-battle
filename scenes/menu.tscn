offset_right = 366.0
offset_bottom = 643.0
theme_override_constants/outline_size = 10
theme_override_font_sizes/normal_font_size = 20
text = "Pizzaman is a jack of all trades. He has his own specialized inventory (which you can see on the right) with all the \"balls\" he can equip. Each ball has a different effect and will act as a reliable source of damage. 

TIP: Despite being a jack of all trades, he is a master of none. Don't rely on him."
fit_content = true

