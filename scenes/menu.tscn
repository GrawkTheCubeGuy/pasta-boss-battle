theme_override_constants/outline_size = 10
theme_override_font_sizes/normal_font_size = 20
text = "The fork is your main way of dealing damage. It has the highest DPS (Damage Per Second) in the entire game and heals you on impact. However, its drawback is its range.  It can only hit right in front of you.

TIP: You can only reliably hit the boss when it is grounded.

"
fit_content = true

